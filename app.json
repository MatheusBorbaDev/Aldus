{
  "expo": {
    "name": "Aldus",
    "slug": "aldus-reader",
    "version": "1.0.0-beta.2",
    "orientation": "portrait",
    "android": {
      "package": "com.aldus.reader",
      "versionCode": 19,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "content",
              "mimeType": "application/epub+zip"
            }
          ]
        }
      ]
    },
    "userInterfaceStyle": "automatic",
    "scheme": "aldus",
    "web": {
      "name": "Aldus Reader",
      "shortName": "Aldus",
      "lang": "pt-BR",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "fd89ca78-4621-4457-bace-07638decbb2e"
      }
    },
    "owner": "matheusborba19s-team",
    "icon": "./assets/brand/icon-512.png"
  }
}
