<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (SDK 31+): nada do Aldus vai para o backup na nuvem nem para a transferência direta entre aparelhos.
  Decisão do dono em 16/11/2026 (verificação de segurança): a sessão de login e a biblioteca local ficam fora de backups.
  O que deve passar de um aparelho a outro vai pela sincronização da conta. Abaixo do SDK 31 vale android:allowBackup="false".
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
  </device-transfer>
</data-extraction-rules>
